.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-workspace
*.sublime-project

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
dist/
.env.local
.env.*.local

# Testing
.pytest_cache/
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Documentación generada
docs/_build/
site/

# Archivos de sistema
.DS_Store
Thumbs.db
*.log

# Docker
.dockerignore
docker-compose.override.yml

# Entorno local
.env
.env.*.local
.env.production.local
.env.development.local

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp

# Build artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Redis
dump.rdb
appendonly.aof

